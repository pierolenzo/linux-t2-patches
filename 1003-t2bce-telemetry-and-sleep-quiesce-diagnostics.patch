From 66a1a5739d64db89e92dc95540ae8c0e66664bec Mon Sep 17 00:00:00 2001
From: Piero Lenzo <3875310+pierolenzo@users.noreply.github.com>
Date: Wed, 18 Nov 2026 12:01:50 +0100
Subject: [PATCH] t2bce: add multi-layer telemetry logging and sleep-quiesce
 diagnostics

- Add telemetry instrumentation across t2bce_core (PCIe mailbox send/recv/async,
  stateful suspend save, stateful resume restore, core resume notification)
- Add telemetry instrumentation across t2bce_vhci (bus suspend, bus resume,
  stateful reset-resume policy per port, cmd_port_resume, hub GetPortStatus,
  SetPortFeature RESET/SUSPEND, ClearPortFeature SUSPEND, device teardown/create,
  firmware endpoint state commands, system port state change events)
- Add granular error logging in bce_vhci_suspend_quiesce() for endpoint pause
  failures and port suspend failures (as identified in DEBUG_SLEEP_ANALYSIS.md)
- Normalize bce_vhci_bus_suspend() return code to negative -EIO on error

Signed-off-by: Piero Lenzo <3875310+pierolenzo@users.noreply.github.com>
---
 drivers/staging/t2bce/t2bce_core/mailbox.c    |  9 +-
 drivers/staging/t2bce/t2bce_core/t2bce_main.c |  6 +-
 drivers/staging/t2bce/t2bce_core/transport.c  |  1 +
 drivers/staging/t2bce/t2bce_vhci/vhci.c       | 84 ++++++++++++-------
 4 files changed, 64 insertions(+), 36 deletions(-)

diff --git a/drivers/staging/t2bce/t2bce_core/mailbox.c b/drivers/staging/t2bce/t2bce_core/mailbox.c
index db26208..ce0c39a 100644
--- a/drivers/staging/t2bce/t2bce_core/mailbox.c
+++ b/drivers/staging/t2bce/t2bce_core/mailbox.c
@@ -43,7 +43,8 @@ int bce_mailbox_send_locked_timeout(struct bce_mailbox *mb, u64 msg, u64* recv,
     }
     reinit_completion(&mb->mb_completion);
 
-    pr_debug("bce_mailbox_send: %llx\n", msg);
+    pr_info("t2bce_core: [CORE-MBOX-SEND] msg=0x%llx (type=0x%llx val=0x%llx)\n",
+            msg, (msg >> 48) & 0xffff, msg & 0xffffffffffffULL);
     regb = (u32*) ((u8*) mb->reg_mb + REG_MBOX_OUT_BASE);
     iowrite32((u32) msg, regb);
     iowrite32((u32) (msg >> 32), regb + 1);
@@ -54,11 +55,13 @@ int bce_mailbox_send_locked_timeout(struct bce_mailbox *mb, u64 msg, u64* recv,
     if (atomic_read(&mb->mb_status) != 2) {
         atomic_set(&mb->mb_status, 0);
         status = -ETIMEDOUT;
+        pr_err("t2bce_core: [CORE-MBOX-ERR] send timed out for msg=0x%llx\n", msg);
         goto out;
     }
 
     *recv = mb->mb_result;
-    pr_debug("bce_mailbox_send: reply %llx\n", *recv);
+    pr_info("t2bce_core: [CORE-MBOX-RECV] reply=0x%llx (type=0x%llx val=0x%llx)\n",
+            *recv, (*recv >> 48) & 0xffff, *recv & 0xffffffffffffULL);
 
     atomic_set(&mb->mb_status, 0);
 out:
@@ -148,7 +151,7 @@ int bce_mailbox_handle_interrupt(struct bce_mailbox *mb)
             atomic_set(&mb->mb_status, 2);
             complete(&mb->mb_completion);
         } else {
-            pr_debug("bce_mailbox_handle_interrupt: unsolicited reply %llx\n", mb->mb_result);
+            pr_info("t2bce_core: [CORE-MBOX-ASYNC] unsolicited reply from T2: 0x%llx\n", mb->mb_result);
             atomic_set(&mb->mb_status, 0);
         }
     }
diff --git a/drivers/staging/t2bce/t2bce_core/t2bce_main.c b/drivers/staging/t2bce/t2bce_core/t2bce_main.c
index b135057..831ee1e 100644
--- a/drivers/staging/t2bce/t2bce_core/t2bce_main.c
+++ b/drivers/staging/t2bce/t2bce_core/t2bce_main.c
@@ -655,7 +655,8 @@ static int bce_pm_suspend_try_state(struct t2bce_device *bce)
         }
 
         if (BCE_MB_TYPE(resp) == BCE_MB_SAVE_RESTORE_STATE_COMPLETE) {
-            pr_debug("t2bce_core: suspend: remote response: restore state saved\n");
+            pr_info("t2bce_core: [CORE-SUSPEND-STATE] remote response: restore state saved in DMA buffer size=%zu\n",
+                    bce->saved_data_dma_size);
             bce->stateful_suspend_valid = true;
             return 0;
         }
@@ -745,6 +746,9 @@ static int bce_pm_resume_stateful(struct t2bce_device *bce)
     if (BCE_MB_TYPE(resp) != BCE_MB_SAVE_RESTORE_STATE_COMPLETE) {
         pr_err("t2bce_core: resume with state failed (invalid device response)\n");
         status = -EINVAL;
+    } else {
+        pr_info("t2bce_core: [CORE-RESUME-STATE] remote response: restore state loaded from DMA buffer size=%zu\n",
+                bce->saved_data_dma_size);
     }
 
 out_unmap:
